generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(uuid())
  name                  String
  email                 String                 @unique
  designation           String?
  organization          String?
  contact               String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  password              String
  approvals             Approval[]
  uploadedAttachments   Attachment[]
  auditLogs             AuditLog[]
  customizationHistory  CustomizationHistory[]
  customizationRequests CustomizationRequest[] @relation("CustomizationRequester")
  notifications         Notification[]
  roles                 UserRole[]
  appliedSpecs          VmSpec[]               @relation("VmSpecApplier")
  developedRequests     Request[]              @relation("Developer")
  requests              Request[]              @relation("Requester")
  ownedVms              VmInstance[]           @relation("VmOwner")
  credentialAccessLogs  CredentialAccessLog[]
  horizonAssigned       HorizonAssignment[]    @relation("HorizonAssignedBy")
  vpnAssigned           VpnAssignment[]        @relation("VpnAssignedBy")
  subdomainsRequested   K8sSubdomain[]         @relation("SubdomainRequester")
  subdomainsApproved    K8sSubdomain[]         @relation("SubdomainApprover")
}

model Role {
  id    String     @id @default(cuid())
  name  String     @unique
  users UserRole[]
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Request {
  id                            String                 @id @default(uuid())
  requestType                   RequestType
  status                        RequestStatus          @default(DRAFT)
  quantity                      Int                    @default(1)
  requestId                     String?                @unique
  projectName                   String?
  systemName                    String
  purpose                       String
  environment                   Environment
  requesterId                   String
  alternativePersonName         String?
  alternativePersonDesignation  String?
  alternativePersonOrganization String?
  alternativePersonContact      String?
  alternativePersonEmail        String?
  developerName                 String?
  developerContact              String?
  developerEmail                String?
  serverType                    ServerType
  vcpu                          Int?
  ramGb                         Int?
  osName                        String?
  osVersion                     String?
  osLicenseBy                   LicenseProvider?
  storageGb                     Int?
  subdomain                     String?
  sslProvider                   SSLProvider?
  sslCostPaidBy                 String?
  retentionPeriod               String?
  requiredPublicIP              Boolean                @default(false)
  vaReportSubmitted             Boolean                @default(false)
  justificationSubmitted        Boolean                @default(false)
  renewalRequired               Boolean                @default(false)
  renewalPeriodMonths           Int?
  createdAt                     DateTime               @default(now())
  submittedAt                   DateTime?
  updatedAt                     DateTime               @updatedAt
  provisionedAt                 DateTime?              @map("provisioned_at")
  frontendTech                  String?
  backendTech                   String?
  serverArchitecture            String?
  additionalTechNotes           String?
  dataBase                      String?
  vpnRequired                   Boolean                @default(false)
  vpnDetails                    String?                @db.Text
  targetVmId                    String?
  developerDesignation          String?
  developerId                   String?
  developerOrganization         String?

  // Clone VM fields
  sourceVmId                    String?
  cloneFullDisk                 Boolean                @default(true)
  // K8s Namespace fields
  kubernetesOption              Boolean                @default(false)
  kubernetesNamespace           String?
  // Virtual IP fields
  virtualIpType                 String?                // PUBLIC or PRIVATE
  assignedIpAddress             String?
  // Credentials tracking
  credentialsDelivered          Boolean                @default(false)
  credentialsDeliveredAt        DateTime?

  additionalDisks               AdditionalDisk[]
  approvals                     Approval[]             @relation("RequestApprovals")
  attachments                   Attachment[]
  customizations                CustomizationRequest[] @relation("CustomizationParent")
  firewallPorts                 FirewallPort[]
  networkAccess                 NetworkAccessEntry[]
  specs                         VmSpec[]               @relation("RequestSpecs")
  developer                     User?                  @relation("Developer", fields: [developerId], references: [id])
  requester                     User                   @relation("Requester", fields: [requesterId], references: [id])
  targetVm                      VmInstance?            @relation("DecommissionTarget", fields: [targetVmId], references: [id])
  sourceVm                      VmInstance?            @relation("VmCloneSource", fields: [sourceVmId], references: [id])
  clonedVms                     VmInstance[]           @relation("VmCloneResult")
  vmInstances                   VmInstance[]           @relation("RequestVms")
  k8sRequestNodeGroups          K8sRequestNodeGroup[]
  k8sClusters                   K8sCluster[]           @relation("ClusterRequest")

  // K8s cluster request fields
  underExistingNamespace        Boolean                @default(false)
  existingNamespaceId           String?                // FK -> K8sNamespace
  existingNamespace             K8sNamespace?          @relation("ExistingNamespace", fields: [existingNamespaceId], references: [id])

  // System upgrade fields
  upgradeVmId                   String?                // FK -> VmInstance being upgraded
  upgradeCpu                    Int?                   // requested new vCPU count
  upgradeRamGb                  Int?                   // requested new RAM (GB)
  upgradeStorageGb              Int?                   // requested additional storage (GB)
  upgradeJustification          String?                @db.Text
  upgradeVm                     VmInstance?            @relation("UpgradeTarget", fields: [upgradeVmId], references: [id])

  // Access request fields (VPN / Horizon)
  accessTargetVmId              String?                // FK -> VmInstance access is for
  accessType                    AccessType?            // VPN | HORIZON
  accessJustification           String?                @db.Text
  accessTargetVm                VmInstance?            @relation("AccessTarget", fields: [accessTargetVmId], references: [id])

  // Common new fields
  tags                          RequestTag[]
  vmSpecifications              VmSpecification[]
  requestResources              RequestResource[]

  @@index([targetVmId])
  @@index([sourceVmId])
  @@index([requesterId])
  @@index([status])
  @@index([environment])
  @@index([requesterId, status])
  @@index([environment, status])
  @@index([submittedAt])
  @@index([requestType, targetVmId])
  @@index([existingNamespaceId])
  @@index([upgradeVmId])
  @@index([accessTargetVmId])
  @@map("requests")
}

model AdditionalDisk {
  id                String           @id @default(uuid())
  requestId         String
  sizeGb            Int
  purpose           String?
  sequence          Int
  request           Request          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vmSpecificationId String?
  vmSpecification   VmSpecification? @relation(fields: [vmSpecificationId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([vmSpecificationId])
}

model FirewallPort {
  id                String           @id @default(uuid())
  requestId         String
  port              Int
  protocol          Protocol
  purpose           String
  source            String?
  request           Request          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vmSpecificationId String?
  vmSpecification   VmSpecification? @relation(fields: [vmSpecificationId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([vmSpecificationId])
}

model NetworkAccessEntry {
  id                String           @id @default(uuid())
  requestId         String
  accessType        NetworkAccess
  request           Request          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vmSpecificationId String?
  vmSpecification   VmSpecification? @relation(fields: [vmSpecificationId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([vmSpecificationId])
}

model VmSpecification {
  id                String                 @id @default(uuid())
  requestId         String
  request           Request                @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stack             String?
  environment       Environment
  vcpu              Int
  ramGb             Int
  storageGb         Int
  gpuEnabled        Boolean                @default(false)
  gpuVramGb         Int?
  gpuStorageGb      Int?
  osVersion         String?
  subdomain         String?
  vpnDetails        String?                @db.Text

  connectivity      NetworkAccessEntry[]
  firewallRules     FirewallPort[]
  additionalStorage AdditionalDisk[]

  @@index([requestId])
}

model Approval {
  id                     String                @id @default(uuid())
  entityType             ApprovalEntityType
  level                  Int
  approverId             String
  decision               ApprovalDecision      @default(PENDING)
  comments               String?
  decidedAt              DateTime?
  createdAt              DateTime              @default(now())
  customizationRequestId String?
  requestId              String?
  approver               User                  @relation(fields: [approverId], references: [id])
  customizationRequest   CustomizationRequest? @relation("CustomizationApprovals", fields: [customizationRequestId], references: [id], onDelete: Cascade)
  request                Request?              @relation("RequestApprovals", fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([customizationRequestId])
  @@index([approverId, decision])
  @@index([entityType, decision])
}

model VmInstance {
  id                    String                 @id @default(uuid())
  requestId             String?
  sequenceNumber        Int
  ownerId               String?
  hostname              String?                @unique
  ipAddress             String?                @unique
  publicIpAddress       String?
  status                VmStatus               @default(ACTIVE)
  renewalDate           DateTime?
  decommissionedAt      DateTime?
  hasRemoteAccess       Boolean                @default(false)
  vpnRequired           Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  provisionedAt         DateTime?              @map("provisioned_at")
  currentSpecId         String?                @unique
  subdomain             String?
  environment           Environment?
  hostAssetId           String?
  hostAsset             Asset?                 @relation("HostedOnAsset", fields: [hostAssetId], references: [id])
  auditLogs             AuditLog[]             @relation("VmAudit")
  customizationHistory  CustomizationHistory[]
  customizationRequests CustomizationRequest[] @relation("CustomizationTarget")
  specHistory           VmSpec[]               @relation("VmSpecHistory")
  systemName            String?
  decommissionRequests  Request[]              @relation("DecommissionTarget")
  horizonAssignmentsOld HorizonAssignment[]    @relation("VmToHorizonOld")
  horizonAssignmentsNew HorizonAssignment[]    @relation("VmToHorizonNew")
  vpnAssignmentsNew     VpnAssignment[]        @relation("VmToVpnNew")
  requestResources      RequestResource[]
  currentSpec           VmSpec?                @relation("CurrentVmSpec", fields: [currentSpecId], references: [id])
  owner                 User?                  @relation("VmOwner", fields: [ownerId], references: [id])
  request               Request?                @relation("RequestVms", fields: [requestId], references: [id])
  // Clone relations
  clonedFrom            Request[]              @relation("VmCloneSource")
  cloneOfRequestId      String?
  cloneOf               Request?               @relation("VmCloneResult", fields: [cloneOfRequestId], references: [id])
  upgradeRequests       Request[]              @relation("UpgradeTarget")
  accessRequests        Request[]              @relation("AccessTarget")
  credential            VmCredential?
  credentialAccessLogs  CredentialAccessLog[]
  tags                  VmTag[]

  @@unique([requestId, sequenceNumber])
  @@index([ownerId])
  @@index([status])
  @@index([ownerId, status])
  @@index([environment, status])
  @@index([hostAssetId])
  @@index([cloneOfRequestId])
  @@map("vm_instances")
}

model VmSpec {
  id                     String                 @id @default(uuid())
  vmInstanceId           String
  vcpu                   Int
  ramGb                  Int
  storageGb              Int
  osName                 String?
  osVersion              String?
  effectiveFrom          DateTime               @default(now())
  createdAt              DateTime               @default(now())
  appliedById            String?
  sourceRequestId        String?
  customizationRequestId String?                @unique
  nextIn                 CustomizationHistory[] @relation("NewSpec")
  previousIn             CustomizationHistory[] @relation("PreviousSpec")
  appliedBy              User?                  @relation("VmSpecApplier", fields: [appliedById], references: [id])
  customizationRequest   CustomizationRequest?  @relation("CustomizationAppliedSpec", fields: [customizationRequestId], references: [id])
  sourceRequest          Request?               @relation("RequestSpecs", fields: [sourceRequestId], references: [id])
  vmInstance             VmInstance             @relation("VmSpecHistory", fields: [vmInstanceId], references: [id])
  additionalDisks        VmSpecDisk[]
  firewallPorts          VmSpecFirewallPort[]
  networkAccess          VmSpecNetworkAccess[]
  currentForVm           VmInstance?            @relation("CurrentVmSpec")

  @@index([vmInstanceId])
  @@index([effectiveFrom])
}

model VmSpecDisk {
  id       String  @id @default(uuid())
  specId   String
  sizeGb   Int
  purpose  String?
  sequence Int
  spec     VmSpec  @relation(fields: [specId], references: [id], onDelete: Cascade)

  @@index([specId])
}

model VmSpecFirewallPort {
  id       String   @id @default(uuid())
  specId   String
  port     Int
  protocol Protocol
  purpose  String
  source   String?
  spec     VmSpec   @relation(fields: [specId], references: [id], onDelete: Cascade)

  @@index([specId])
}

model VmSpecNetworkAccess {
  id         String        @id @default(uuid())
  specId     String
  accessType NetworkAccess
  spec       VmSpec        @relation(fields: [specId], references: [id], onDelete: Cascade)

  @@index([specId])
}

model CustomizationRequest {
  id              String                @id @default(uuid())
  parentRequestId String?
  targetVmId      String
  vcpu            Int?
  ramGb           Int?
  storageGb       Int?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  requesterId     String?
  purpose         String?
  submittedAt     DateTime?
  status          CustomizationStatus   @default(DRAFT)
  additionalDisks AdditionalDiskInput[]
  approvals       Approval[]            @relation("CustomizationApprovals")
  parentRequest   Request?              @relation("CustomizationParent", fields: [parentRequestId], references: [id])
  requester       User?                 @relation("CustomizationRequester", fields: [requesterId], references: [id])
  targetVm        VmInstance            @relation("CustomizationTarget", fields: [targetVmId], references: [id])
  firewallPorts   FirewallPortInput[]
  networkAccess   NetworkAccessInput[]
  resultingSpec   VmSpec?               @relation("CustomizationAppliedSpec")

  @@index([targetVmId])
  @@index([status])
  @@index([requesterId])
  @@index([createdAt])
}

model AdditionalDiskInput {
  id                   String               @id @default(uuid())
  customizationId      String
  sizeGb               Int
  purpose              String?
  sequence             Int
  customizationRequest CustomizationRequest @relation(fields: [customizationId], references: [id])
}

model FirewallPortInput {
  id                   String               @id @default(uuid())
  customizationId      String
  port                 Int
  protocol             Protocol
  purpose              String
  source               String?
  customizationRequest CustomizationRequest @relation(fields: [customizationId], references: [id])
}

model NetworkAccessInput {
  id                   String               @id @default(uuid())
  customizationId      String
  accessType           NetworkAccess
  customizationRequest CustomizationRequest @relation(fields: [customizationId], references: [id])
}

model CustomizationHistory {
  id           String     @id @default(uuid())
  vmId         String
  beforeSpecId String
  afterSpecId  String
  appliedById  String?
  createdAt    DateTime   @default(now())
  reason       String?
  afterSpec    VmSpec     @relation("NewSpec", fields: [afterSpecId], references: [id])
  appliedBy    User?      @relation(fields: [appliedById], references: [id])
  beforeSpec   VmSpec     @relation("PreviousSpec", fields: [beforeSpecId], references: [id])
  vm           VmInstance @relation(fields: [vmId], references: [id], onDelete: Cascade)

  @@index([vmId])
  @@index([beforeSpecId])
  @@index([afterSpecId])
  @@index([appliedById])
}

model Attachment {
  id             String         @id @default(uuid())
  requestId      String
  fileName       String
  filePath       String
  attachmentType AttachmentType
  uploadedBy     String
  createdAt      DateTime       @default(now())
  request        Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [uploadedBy], references: [id])
}

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String
  action     String
  entityType String?
  entityId   String?
  details    Json?
  timestamp  DateTime    @default(now())
  vmId       String?
  actor      User        @relation(fields: [actorId], references: [id])
  vm         VmInstance? @relation("VmAudit", fields: [vmId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([timestamp])
  @@index([vmId])
  @@index([actorId, timestamp])
}

model SoftwareLicense {
  id                String    @id @default(uuid())
  name              String
  vendor            String
  expiryDate        DateTime?
  maintenanceExpiry DateTime?
  type              String
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  assets            Asset[]   @relation("AssetToSoftwareLicense")

  @@unique([name, vendor])
}

model Asset {
  id                String            @id @default(uuid())
  type              AssetType
  name              String
  vendor            String?
  model             String?
  serial            String?           @unique
  location          String?
  warrantyExpiry    DateTime?
  cpuCores          Int?
  ramGb             Int?
  storageGb         Int?
  graphicsCardModel String?
  graphicsCardSpec  String?
  interfaces        Int?
  throughputGbps    Float?
  vlanSupport       Boolean?
  capacityTb        Float?
  noOfDisks         Int?
  details           Json?
  createdAt         DateTime          @default(now())
  clusterId         String?
  cluster           PhysicalCluster?  @relation("HostsInCluster", fields: [clusterId], references: [id])
  vms               VmInstance[]      @relation("HostedOnAsset")
  licenses          SoftwareLicense[] @relation("AssetToSoftwareLicense")
}

model PhysicalCluster {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  hosts       Asset[]  @relation("HostsInCluster")
  createdAt   DateTime @default(now())
}

model SystemSetting {
  key         String   @id
  value       String
  label       String?
  description String?
  category    String   @default("general") // general, smtp, storage
  isSecret    Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model ApprovalWorkflow {
  id          String   @id @default(uuid())
  requestType String   // NEW_VM, CUSTOMIZED, DECOMMISSION, RENEWAL
  level       Int
  role        String   // APPROVER_L1, APPROVER_L2, APPROVER_L3, APPROVER_L4, DC_OPS
  roleLabel   String?  // Human readable label like "Section Officer", "Director"
  isFinal     Boolean  @default(false) // If true, this is the final approval level
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requestType, level])
  @@index([requestType])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

enum RequestType {
  NEW_VM
  CLONE_VM
  K8S_NAMESPACE
  CUSTOMIZED
  RENEWAL
  DECOMMISSION
  VPN_ACCESS
  HORIZON_ACCESS
  SYSTEM_UPGRADE
}

enum RequestStatus {
  DRAFT
  PENDING_L1
  PENDING_L2
  PENDING_L3
  APPROVED
  REJECTED
  PROVISIONED
  PARTIALLY_PROVISIONED
  CLOSED
  REQUESTER_APPROVED
  PENDING_L4
}

enum CustomizationStatus {
  DRAFT
  PENDING_L1
  PENDING_L2
  PENDING_L3
  APPROVED
  REJECTED
  APPLIED
  PENDING_L4
}

enum Protocol {
  TCP
  UDP
  OTHER
}

enum ServerType {
  APPLICATION
  MAIL
  DATABASE
  FTP
  OTHER
}

enum Environment {
  DEVELOPMENT
  STAGING
  PRODUCTION
  TESTING
}

enum LicenseProvider {
  REQUESTER
  PARTNER
  OPEN_SOURCE
}

enum SSLProvider {
  REQUESTER
  MIS
}

enum NetworkAccess {
  LOCAL
  INTERNET
  REMOTE
  VPN
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  FORWARDED
}

enum ApprovalEntityType {
  REQUEST
  CUSTOMIZATION
}

enum VmStatus {
  ACTIVE
  SUSPENDED
  RETIRED
}

enum AttachmentType {
  SECURITY_REPORT
  JUSTIFICATION
}

enum AssetType {
  SERVER
  ROUTER
  SWITCH
  FIREWALL
  STORAGE
  UPS
  CONSOLE_SERVER
  OTHER
}

enum ApprovalLevel {
  L1
  L2
  L3
}

enum AccessType {
  VPN
  HORIZON
}

enum K8sNodeRole {
  MASTER
  WORKER
}

model K8sNamespace {
  id                 String              @id @default(uuid())
  name               String              @unique
  supervisorIp       String
  clusters           K8sCluster[]
  createdAt          DateTime            @default(now())
  requests           Request[]           @relation("ExistingNamespace")
  horizonAssignments HorizonAssignment[] @relation("NamespaceToHorizon")
  vpnAssignments     VpnAssignment[]     @relation("NamespaceToVpn")
  requestResources   RequestResource[]
  subdomains         K8sSubdomain[]
}

model K8sCluster {
  id           String         @id @default(uuid())
  namespaceId  String
  namespace    K8sNamespace   @relation(fields: [namespaceId], references: [id])
  requestId    String?        // originating Request
  request      Request?       @relation("ClusterRequest", fields: [requestId], references: [id])
  clusterName  String
  username     String?        // DCOPS-provisioned
  totalSpaceGb Int?
  status       VmStatus       @default(ACTIVE)
  createdAt    DateTime       @default(now())
  nodeGroups   K8sNodeGroup[]
}

model K8sNodeGroup {
  id         String      @id @default(uuid())
  clusterId  String
  cluster    K8sCluster  @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  role       K8sNodeRole
  nodeCount  Int
  vcpu       Int
  ramGb      Int
  isClonable Boolean     @default(true)
  nodes      K8sNode[]
}

model VmCredential {
  id           String      @id @default(uuid())
  vmInstanceId String      @unique
  vmInstance   VmInstance  @relation(fields: [vmInstanceId], references: [id], onDelete: Cascade)
  username     String
  password     String      // Encrypted with AES-256
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model CredentialAccessLog {
  id           String      @id @default(uuid())
  actorId      String
  actor        User        @relation(fields: [actorId], references: [id], onDelete: Cascade)
  vmInstanceId String
  vmInstance   VmInstance  @relation(fields: [vmInstanceId], references: [id], onDelete: Cascade)
  action       String      // "VIEW" | "EMAIL"
  accessedAt   DateTime    @default(now())
}

model ComplianceTag {
  id           String       @id @default(uuid())
  name         String       @unique
  description  String?
  requests     RequestTag[]
  vmInstances  VmTag[]
  createdAt    DateTime     @default(now())
}

model RequestTag {
  requestId    String
  request      Request      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tagId        String
  tag          ComplianceTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([requestId, tagId])
}

model VmTag {
  vmInstanceId String
  vmInstance   VmInstance   @relation(fields: [vmInstanceId], references: [id], onDelete: Cascade)
  tagId        String
  tag          ComplianceTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([vmInstanceId, tagId])
}

model K8sRequestNodeGroup {
  id        String      @id @default(uuid())
  requestId String
  request   Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  role      K8sNodeRole
  nodeCount Int
  vcpu      Int
  ramGb     Int
  storageGb Int
}

model K8sNode {
  id              String       @id @default(uuid())
  nodeGroupId     String
  nodeGroup       K8sNodeGroup @relation(fields: [nodeGroupId], references: [id], onDelete: Cascade)
  name            String
  ipAddress       String?
  externalIp      String?
  subdomain       String?
  subdomainStatus String       @default("PENDING")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model K8sSubdomain {
  id              String        @id @default(uuid())
  namespaceId     String
  namespace       K8sNamespace  @relation(fields: [namespaceId], references: [id], onDelete: Cascade)
  subdomain       String
  externalIp      String?       // Ingress Controller / External IP
  serviceName     String?       // K8s Service Name
  targetPort      Int?          @default(443)
  purpose         String?
  status          String        @default("PENDING") // PENDING, ACTIVE, REJECTED
  rejectionReason String?
  requestedById   String
  requestedBy     User          @relation("SubdomainRequester", fields: [requestedById], references: [id])
  approvedById    String?
  approvedBy      User?         @relation("SubdomainApprover", fields: [approvedById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([namespaceId])
  @@index([status])
}

model PasswordResetOtp {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model HorizonUser {
  id          String              @id @default(uuid())
  username    String              @unique @map("horizon_username")
  fullName    String              @map("full_name")
  email       String?
  status      String              @default("ACTIVE") // ACTIVE, REVOKED, PENDING
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  assignments HorizonAssignment[]

  @@map("horizon_users")
}

model HorizonAssignment {
  id            String        @id @default(uuid())
  horizonUserId String?       @map("horizon_user_id")
  horizonUser   HorizonUser?  @relation(fields: [horizonUserId], references: [id], onDelete: Cascade)
  vmId          String?       @map("vm_id")
  vm            VmInstance?   @relation("VmToHorizonNew", fields: [vmId], references: [id], onDelete: Cascade)
  namespaceId   String?       @map("namespace_id")
  namespace     K8sNamespace? @relation("NamespaceToHorizon", fields: [namespaceId], references: [id], onDelete: Cascade)
  assignedIp    String?       @map("assigned_ip")
  assignedAt    DateTime      @default(now()) @map("assignment_date")
  assignedById  String?       @map("assigned_by_id")
  assignedBy    User?         @relation("HorizonAssignedBy", fields: [assignedById], references: [id])
  status        String        @default("ACTIVE") // ACTIVE, REVOKED
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt

  // Deprecated legacy fields for data migration safety
  username     String?     @map("horizon_user")
  vmInstanceId String?     @map("vm_instance_id")
  ipAddress    String?     @map("assigned_ip_old")
  oldVm        VmInstance? @relation("VmToHorizonOld", fields: [vmInstanceId], references: [id], onDelete: Cascade)
}

model VpnUser {
  id          String          @id @default(uuid())
  username    String          @unique @map("vpn_username")
  fullName    String          @map("full_name")
  vpnProfile  String          @map("vpn_profile")
  vpnIp       String          @unique @map("vpn_ip")
  status      String          @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  assignments VpnAssignment[]

  @@map("vpn_users")
}

model VpnAssignment {
  id           String        @id @default(uuid())
  vpnUserId    String?       @map("vpn_user_id")
  vpnUser      VpnUser?      @relation(fields: [vpnUserId], references: [id], onDelete: Cascade)
  vmId         String?       @map("vm_id")
  vm           VmInstance?   @relation("VmToVpnNew", fields: [vmId], references: [id], onDelete: Cascade)
  namespaceId  String?       @map("namespace_id")
  namespace    K8sNamespace? @relation("NamespaceToVpn", fields: [namespaceId], references: [id], onDelete: Cascade)
  assignedAt   DateTime      @default(now()) @map("assignment_date")
  assignedById String?       @map("assigned_by_id")
  assignedBy   User?         @relation("VpnAssignedBy", fields: [assignedById], references: [id])
  expiresAt    DateTime?     @map("expiration_date")
  notes        String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt

  // Deprecated legacy fields for data migration safety
  username    String?   @map("vpn_user")
  vpnIp       String?   @map("assigned_vpn_ip_old")
  vpnProfile  String?   @map("vpn_profile_old")
  assignedVms String?   @map("assigned_vms_old")
}

model RequestResource {
  id          String        @id @default(uuid())
  requestId   String        @map("request_id")
  request     Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vmId        String?       @map("vm_id")
  vm          VmInstance?   @relation(fields: [vmId], references: [id], onDelete: Cascade)
  namespaceId String?       @map("namespace_id")
  namespace   K8sNamespace? @relation(fields: [namespaceId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([vmId])
  @@index([namespaceId])
  @@map("request_resources")
}
